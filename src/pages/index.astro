---
import '../styles/global.css';
import Toc from '../components/Toc.svelte';
import Transcript from '../components/Transcript.astro';
import EmpathyMap from '../components/EmpathyMap.astro';
import { interviews } from '../data/interviews';
import { columns, original, updated, feedbackResponses, alignment } from '../data/plan';
import { evidence, references } from '../data/evidence';
import { Content as Synthesis } from '../content/synthesis.md';
import { Content as EvidenceAnalysis } from '../content/evidence-analysis.md';

const team = ['Emma Waggenspack', 'Ella Black', 'Anastasia Coffman', 'Janice Lo', 'Channing Brown'];

const toc = [
  { id: 'top', title: 'Wicked Problem & Team' },
  {
    id: 'part-1',
    title: 'Part 1: Research Plan',
    children: [
      { id: 'feedback', title: 'Response to feedback' },
      { id: 'updated-plan', title: 'Updated plan' },
      { id: 'alignment', title: 'Questions, methods, evidence' },
      { id: 'original-plan', title: 'Original plan' },
    ],
  },
  {
    id: 'part-2',
    title: 'Part 2: Interviews',
    children: [
      { id: 'guide', title: '2A. Interview guide' },
      ...interviews.map((i) => ({ id: i.id, title: `${i.label}: ${i.researcher}` })),
      { id: 'synthesis', title: '2D. Synthesis narrative' },
    ],
  },
  {
    id: 'part-3',
    title: 'Part 3: Artifacts & Documents',
    children: [
      { id: 'evidence', title: '3A. Research evidence' },
      { id: 'analysis', title: '3B. Evidence analysis' },
    ],
  },
  { id: 'references', title: 'References' },
];

const italics = (s: string) => s.replace(/\*(.+?)\*/g, '<em>$1</em>');
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>Women in Engineering at UTK | Ethnography Portfolio</title>
    <meta
      name="description"
      content="UNHO 207 ethnographic evidence and sensemaking portfolio by team Three is a Magic Number: UN SDG 5, women in engineering at UTK."
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&family=Source+Serif+4:ital,wght@0,400;0,600;1,400&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only z-50 rounded bg-peach px-3 py-2 font-sans text-crust no-underline focus:not-sr-only focus:fixed focus:top-2 focus:left-2"
      >Skip to content</a
    >
    <div class="lg:grid lg:grid-cols-[17rem_minmax(0,1fr)]">
      <aside class="sticky top-0 z-20 lg:h-screen lg:self-start">
        <Toc client:load items={toc} />
      </aside>

      <main id="main" class="mx-auto w-full max-w-4xl px-4 pb-24 sm:px-8">
        <!-- Title area -->
        <header id="top" class="border-b border-surface0 pt-10 pb-10 lg:pt-16">
          <p class="font-sans text-sm text-subtext0">UNHO 207 · Ethnographic Evidence &amp; Sensemaking Portfolio</p>
          <h1 class="mt-3 text-3xl leading-tight font-bold sm:text-4xl">Women in Engineering at UTK</h1>
          <p class="mt-2 font-sans text-lg text-peach">UN Sustainable Development Goal 5: Gender Equality</p>

          <div class="mt-6 space-y-4">
            <p>
              Our wicked problem is gender equality in engineering. Women are still a minority in engineering
              classrooms and on engineering faculty. At UT’s Tickle College of Engineering, women are about 25% of
              undergraduates. We wanted to understand what makes it harder for women to stay in engineering at UTK,
              and whether seeing women teach engineering changes how students think about who belongs.
            </p>
            <p>Our two research questions are:</p>
            <ol class="list-decimal space-y-1 pl-6">
              <li>
                How do the biases against women in engineering contribute to the retention of women in the
                engineering program at UTK?
              </li>
              <li>How does seeing female engineering faculty impact gender roles in engineering?</li>
            </ol>
          </div>

          <div class="mt-8 rounded-lg border border-surface0 bg-mantle p-4 font-sans">
            <h2 class="text-sm font-semibold text-subtext1">Team: Three is a Magic Number</h2>
            <ul class="mt-2 flex flex-wrap gap-x-5 gap-y-1 text-text">
              {team.map((m) => <li>{m}</li>)}
            </ul>
          </div>
        </header>

        <!-- PART 1 -->
        <section id="part-1" class="pt-12" aria-labelledby="part-1-h">
          <p class="font-sans text-sm font-semibold tracking-wide text-peach uppercase">Part 1</p>
          <h2 id="part-1-h" class="text-2xl font-bold">Updated Conceptual Research Plan</h2>
          <p class="mt-3">
            This is our conceptual research plan after Dr. Mac’s feedback and after we finished our fieldwork. We
            changed it to match the methods we actually used: ethnographic interviews and artifact and document
            collection.
          </p>

          <h3 id="feedback" class="mt-10 text-xl font-semibold text-mauve">How we responded to feedback</h3>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse font-sans text-sm">
              <thead>
                <tr>
                  <th scope="col" class="w-2/5 border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">Feedback</th>
                  <th scope="col" class="border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">What we changed</th>
                </tr>
              </thead>
              <tbody>
                {
                  feedbackResponses.map((f) => (
                    <tr>
                      <td class="border border-surface1 px-3 py-2 align-top text-subtext1">{f.feedback}</td>
                      <td class="border border-surface1 px-3 py-2 align-top">{f.response}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h3 id="updated-plan" class="mt-10 text-xl font-semibold text-mauve">Updated plan</h3>
          <p class="mt-2 font-sans text-sm text-subtext0">
            One card per research question. The same ten planning questions are answered for each.
          </p>
          <div class="mt-4 grid gap-6 xl:grid-cols-2">
            {
              updated.map((row, r) => (
                <article class="rounded-lg border border-surface0 bg-mantle">
                  <h4 class="border-b border-surface0 px-4 py-3 font-sans font-semibold text-text">
                    <span class="text-peach">RQ{r + 1}.</span> {row[0]}
                  </h4>
                  <dl class="divide-y divide-surface0 text-sm">
                    {columns.slice(1).map((c, i) => (
                      <div class="px-4 py-3">
                        <dt class="font-sans text-xs font-semibold text-subtext0">{c}</dt>
                        <dd class="mt-1">{row[i + 1]}</dd>
                      </div>
                    ))}
                  </dl>
                </article>
              ))
            }
          </div>

          <h3 id="alignment" class="mt-10 text-xl font-semibold text-mauve">How our questions, methods, and evidence line up</h3>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse font-sans text-sm">
              <thead>
                <tr>
                  <th scope="col" class="border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">Research question</th>
                  <th scope="col" class="border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">Method</th>
                  <th scope="col" class="border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">Evidence we found</th>
                </tr>
              </thead>
              <tbody>
                {
                  alignment.map((a) => (
                    <tr>
                      <td class="border border-surface1 px-3 py-2 align-top whitespace-nowrap">{a.rq}</td>
                      <td class="border border-surface1 px-3 py-2 align-top">{a.method}</td>
                      <td class="border border-surface1 px-3 py-2 align-top">
                        <ul class="list-disc space-y-1 pl-4">
                          {a.evidence.map((e) => (
                            <li>{e}</li>
                          ))}
                        </ul>
                      </td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h3 id="original-plan" class="mt-10 text-xl font-semibold text-mauve">Original plan (as first submitted)</h3>
          <p class="mt-2 font-sans text-sm text-subtext0">Kept for comparison. Scroll sideways on small screens.</p>
          <div class="mt-4 overflow-x-auto rounded-lg border border-surface0">
            <table class="min-w-[64rem] border-collapse font-sans text-xs">
              <thead>
                <tr>
                  {columns.map((c) => (
                    <th scope="col" class="border border-surface1 bg-mantle px-2 py-2 text-left align-top text-subtext1">{c}</th>
                  ))}
                </tr>
              </thead>
              <tbody>
                {
                  original.map((row) => (
                    <tr>
                      {row.map((cell) => (
                        <td class="border border-surface1 px-2 py-2 align-top">{cell}</td>
                      ))}
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>
        </section>

        <!-- PART 2 -->
        <section id="part-2" class="mt-16 border-t border-surface0 pt-12" aria-labelledby="part-2-h">
          <p class="font-sans text-sm font-semibold tracking-wide text-peach uppercase">Part 2</p>
          <h2 id="part-2-h" class="text-2xl font-bold">Ethnographic Interviews and Sensemaking</h2>
          <p class="mt-3">
            We interviewed five people. Each team member led one interview. To protect participants’ privacy, we call
            them P1 through P5 and removed their names from transcripts and empathy maps.
          </p>

          <h3 id="guide" class="mt-10 text-xl font-semibold text-mauve">2A. Interview Guide</h3>
          <p class="mt-2">
            This is the interview guide our team used. Each researcher’s actual questions are listed with their
            interview below.
          </p>
          <div class="mt-4 space-y-5 rounded-lg border border-surface0 bg-mantle p-5 text-sm">
            <div>
              <h4 class="font-sans font-semibold text-text">Interview purpose</h4>
              <p class="mt-1">
                We want to learn more about engineering faculty’s experiences and how it differs to engineering
                student’s experiences. We want to primarily focus on women because they are more likely to be aware
                of the gender gap in the engineering field.
              </p>
            </div>
            <div>
              <h4 class="font-sans font-semibold text-text">Participant selection</h4>
              <p class="mt-1">
                We hope to interview someone who has a good amount of knowledge and experience with gender
                inequality, specifically within the engineering department. Our team plans to interview at least 5
                people. We hope that many of them are teachers or engineering students that would have stories about
                what they have experienced. We also want to interview someone in the Women in Engineering Society at
                UTK to see their insights as well. Our perspective is currently limited because we haven’t
                experienced any of this specifically in the engineering field.
              </p>
            </div>
            <div>
              <h4 class="font-sans font-semibold text-text">Questions</h4>
              <dl class="mt-2 space-y-3">
                <div>
                  <dt class="font-sans text-xs font-semibold text-subtext0">A. Opening and rapport-building</dt>
                  <dd>
                    <ul class="mt-1 list-disc space-y-1 pl-5">
                      <li>Tell us about your educational or professional journey in engineering.</li>
                      <li>What made you interested in this field originally?</li>
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="font-sans text-xs font-semibold text-subtext0">B. Experience and behavior</dt>
                  <dd>
                    <ul class="mt-1 list-disc space-y-1 pl-5">
                      <li>
                        What differences, if any, have you observed in student interactions or participation across
                        different classroom settings?
                        <ul class="mt-1 list-[circle] pl-5">
                          <li>Do you think faculty gender plays a role in those differences? If so, how?</li>
                        </ul>
                      </li>
                      <li>How would you describe your experiences teaching and interacting with students in engineering courses?</li>
                      <li>What patterns have you noticed in how students participate in engineering courses?</li>
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="font-sans text-xs font-semibold text-subtext0">C. Challenges, needs, and perspectives</dt>
                  <dd>
                    <ul class="mt-1 list-disc space-y-1 pl-5">
                      <li>What factors have influenced your opportunities for professional growth or advancement in engineering?</li>
                      <li>How would you describe the role gender has played, if at all, in your interactions with students or colleagues?</li>
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="font-sans text-xs font-semibold text-subtext0">D. Closing</dt>
                  <dd>
                    <ul class="mt-1 list-disc space-y-1 pl-5">
                      <li>Is there anything else about this experience of yours that would be good for us to know?</li>
                    </ul>
                  </dd>
                </div>
                <div>
                  <dt class="font-sans text-xs font-semibold text-subtext0">Follow-up prompts</dt>
                  <dd>
                    <ul class="mt-1 list-disc space-y-1 pl-5">
                      <li>What is a specific example of that experience?</li>
                      <li>Elaborate on what you mean by that.</li>
                      <li>Walk me through that experience.</li>
                      <li>Describe a specific interaction that shaped your perspective.</li>
                    </ul>
                  </dd>
                </div>
              </dl>
            </div>
            <div>
              <h4 class="font-sans font-semibold text-text">Interview procedures</h4>
              <ul class="mt-1 list-disc space-y-1 pl-5">
                <li>
                  <strong>Recruitment and scheduling:</strong> We email prospective interviewees and cc the whole group.
                  We schedule a time that fits the participant and lets two group members be present.
                </li>
                <li>
                  <strong>Setting:</strong> Hodges Library or another location on campus that the participant prefers.
                </li>
                <li>
                  <strong>Roles:</strong> At least two team members at every interview. One interviewer asks questions
                  and one recorder records audio for transcription.
                </li>
                <li>
                  <strong>Documentation and ethics:</strong> We obtain informed consent, protect the interviewee’s
                  confidentiality, and make sure the interview is voluntary. We get consent to record and take
                  fieldnotes without bias and assumptions.
                </li>
              </ul>
            </div>
          </div>

          {
            interviews.map((iv) => (
              <article id={iv.id} class="mt-14 scroll-mt-20" aria-labelledby={`${iv.id}-h`}>
                <h3 id={`${iv.id}-h`} class="text-xl font-semibold text-mauve">
                  Interview {iv.label}
                </h3>
                <dl class="mt-3 grid gap-x-6 gap-y-2 rounded-lg border border-surface0 bg-mantle p-4 font-sans text-sm sm:grid-cols-[8rem_1fr]">
                  <dt class="text-subtext0">Participant</dt>
                  <dd class="font-semibold text-peach">{iv.label}</dd>
                  <dt class="text-subtext0">Role</dt>
                  <dd>{iv.role}</dd>
                  <dt class="text-subtext0">Researcher</dt>
                  <dd class="font-semibold text-sapphire">{iv.researcher}</dd>
                  <dt class="text-subtext0">Format</dt>
                  <dd>{iv.format}</dd>
                </dl>

                <h4 class="mt-6 font-sans font-semibold">A. Questions {iv.researcher} asked</h4>
                <ol class="mt-2 list-decimal space-y-1 pl-6 text-sm">
                  {iv.questions.map((q) => (
                    <li>{q}</li>
                  ))}
                </ol>

                <h4 class="mt-6 mb-2 font-sans font-semibold">B. Transcript</h4>
                {iv.transcriptNote && <p class="mb-3 font-sans text-xs text-subtext0">{iv.transcriptNote}</p>}
                <Transcript turns={iv.transcript} interviewer={iv.researcher} participant={iv.label} />

                <h4 class="mt-6 mb-2 font-sans font-semibold">C. Empathy map</h4>
                <EmpathyMap map={iv.map} label={iv.label} researcher={iv.researcher} />
              </article>
            ))
          }

          <section id="synthesis" class="mt-16" aria-labelledby="synthesis-h">
            <h3 id="synthesis-h" class="text-xl font-semibold text-mauve">2D. Interview Synthesis Narrative</h3>
            <p class="mt-1 font-sans text-sm text-subtext0">Team narrative covering all five interviews.</p>
            <div class="prose-narrative">
              <Synthesis />
            </div>
          </section>
        </section>

        <!-- PART 3 -->
        <section id="part-3" class="mt-16 border-t border-surface0 pt-12" aria-labelledby="part-3-h">
          <p class="font-sans text-sm font-semibold tracking-wide text-peach uppercase">Part 3</p>
          <h2 id="part-3-h" class="text-2xl font-bold">Additional Method: Artifact and Document Collection</h2>
          <dl class="mt-4 grid gap-x-6 gap-y-2 rounded-lg border border-surface0 bg-mantle p-4 font-sans text-sm sm:grid-cols-[8rem_1fr]">
            <dt class="text-subtext0">Researcher</dt>
            <dd class="font-semibold text-sapphire">Anastasia Coffman</dd>
            <dt class="text-subtext0">Method</dt>
            <dd>Artifact and document collection</dd>
            <dt class="text-subtext0">Setting</dt>
            <dd>Public UT and Society of Women Engineers websites</dd>
            <dt class="text-subtext0">Date collected</dt>
            <dd>November 6, 2026</dd>
          </dl>

          <h3 id="evidence" class="mt-10 text-xl font-semibold text-mauve">3A. Research Evidence</h3>
          <p class="mt-2">
            For our additional method, I collected seven public documents about women in UT’s Tickle College of
            Engineering and about women in engineering faculty nationally. The table below lists each one and what I
            took from it.
          </p>
          <div class="mt-4 overflow-x-auto">
            <table class="w-full border-collapse font-sans text-sm">
              <thead>
                <tr>
                  <th scope="col" class="border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">#</th>
                  <th scope="col" class="border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">Artifact</th>
                  <th scope="col" class="border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">Source and date</th>
                  <th scope="col" class="border border-surface1 bg-mantle px-3 py-2 text-left text-subtext1">What it shows</th>
                </tr>
              </thead>
              <tbody>
                {
                  evidence.map((e) => (
                    <tr>
                      <td class="border border-surface1 px-3 py-2 align-top text-peach">{e.n}</td>
                      <td class="border border-surface1 px-3 py-2 align-top">
                        <a href={e.url} target="_blank" rel="noopener">{e.artifact}</a>
                      </td>
                      <td class="border border-surface1 px-3 py-2 align-top text-subtext1">{e.source}</td>
                      <td class="border border-surface1 px-3 py-2 align-top">{e.shows}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <section id="analysis" class="mt-10" aria-labelledby="analysis-h">
            <h3 id="analysis-h" class="text-xl font-semibold text-mauve">3B. Evidence Analysis Narrative</h3>
            <div class="prose-narrative">
              <EvidenceAnalysis />
            </div>
          </section>
        </section>

        <!-- REFERENCES -->
        <section id="references" class="mt-16 border-t border-surface0 pt-12" aria-labelledby="references-h">
          <h2 id="references-h" class="text-2xl font-bold">References</h2>
          <ul class="mt-4 space-y-3">
            {
              references.map((r) => (
                <li class="pl-8 -indent-8 text-sm">
                  <Fragment set:html={italics(r.text)} />{' '}
                  <a href={r.url} target="_blank" rel="noopener" class="break-all">{r.url}</a>
                </li>
              ))
            }
          </ul>
        </section>

        <footer class="mt-20 border-t border-surface0 pt-6 font-sans text-xs text-subtext0">
          <p>UNHO 207, Problem Solving &amp; Human-Centered Design · University of Tennessee, Knoxville · Fall 2026</p>
          <p class="mt-1">
            Participant names are replaced with P1 to P5. Audio recordings are not published.
          </p>
        </footer>
      </main>
    </div>
  </body>
</html>
