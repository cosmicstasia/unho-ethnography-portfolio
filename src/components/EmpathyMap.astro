---
import type { EmpathyMap } from '../data/interviews';

interface Props {
  map: EmpathyMap | null;
  label: string;
  researcher: string;
}
const { map, label, researcher } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const src = map ? base + map.image : '';

const quadrants = map
  ? [
      { name: 'Says', items: map.says, kind: 'Stated', dot: 'bg-blue', text: 'text-blue' },
      { name: 'Thinks', items: map.thinks, kind: 'Inferred', dot: 'bg-magenta', text: 'text-magenta' },
      { name: 'Does', items: map.does, kind: 'Stated', dot: 'bg-green', text: 'text-green' },
      { name: 'Feels', items: map.feels, kind: 'Inferred', dot: 'bg-orange', text: 'text-orange' },
    ]
  : [];
---

{
  map ? (
    <figure class="@container">
      <a
        href={src}
        class="group block overflow-hidden rounded-lg border border-line bg-white p-2 shadow-[0_8px_24px_-12px_color-mix(in_oklab,var(--c-fg)_35%,transparent)]"
      >
        <img
          src={src}
          alt={map.imageAlt}
          width={map.width}
          height={map.height}
          loading="lazy"
          decoding="async"
          class="h-auto w-full rounded transition-transform duration-500 ease-out-expo group-hover:scale-[1.01] motion-reduce:transform-none motion-reduce:transition-none"
        />
        <span class="sr-only">Open full-size image</span>
      </a>
      <figcaption class="mt-2.5 font-sans text-xs text-muted">
        Empathy map for {label}, made by {researcher}. The map uses the P-label in place of the participant’s name. Select the image
        to open it full size.
      </figcaption>

      <div class="mt-6 grid grid-cols-[repeat(auto-fit,minmax(min(100%,max(17rem,calc(50%-1px))),1fr))] gap-px overflow-hidden rounded-lg border border-line bg-line">
        {quadrants.map((q) => (
          <section class="bg-sunken p-4 sm:p-5">
            <h5 class="flex items-center gap-2 font-sans text-sm">
              <span class:list={['size-2 rounded-full', q.dot]} aria-hidden="true" />
              <span class:list={['font-bold', q.text]}>{q.name}</span>
              <span class="ml-auto text-xs text-muted">{q.kind}</span>
            </h5>
            <ul class="mt-3 space-y-2 text-[0.95rem] leading-snug">
              {q.items.map((item) => (
                <li class="pl-4 -indent-4">
                  <span class="text-muted" aria-hidden="true">
                    –{' '}
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
      <p class="mt-3 font-sans text-xs text-muted">
        <span class="font-bold text-soft">Stated</span> quadrants come from what the participant told us.{' '}
        <span class="font-bold text-soft">Inferred</span> quadrants are our team’s interpretation.
      </p>
    </figure>
  ) : (
    <div class="flex gap-3 rounded-lg border border-dashed border-line-strong bg-sunken p-4 font-sans text-sm">
      <svg class="mt-0.5 size-4 shrink-0 text-yellow" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <circle cx="8" cy="8" r="6.25" stroke="currentColor" stroke-width="1.5" />
        <path d="M8 4.75V8l2 1.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
      </svg>
      <div>
        <p class="font-bold text-strong">Empathy map in progress</p>
        <p class="mt-0.5 text-soft">
          {researcher} is finishing the empathy map for {label}. It will be added here.
        </p>
      </div>
    </div>
  )
}
