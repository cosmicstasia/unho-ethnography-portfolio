---
import type { Turn } from '../data/interviews';

interface Props {
  turns: Turn[];
  interviewer: string;
  participant: string;
}
const { turns, interviewer, participant } = Astro.props;
const spoken = turns.filter((t) => 's' in t).length;
const first = interviewer.split(' ')[0];
---

<details class="group rounded-lg border border-line bg-sunken">
  <summary
    class="flex cursor-pointer list-none items-center gap-3 rounded-lg px-4 py-3 font-sans text-sm text-fg transition-colors hover:bg-raised/60 [&::-webkit-details-marker]:hidden"
  >
    <svg
      class="size-4 shrink-0 text-muted transition-transform duration-200 group-open:rotate-90 motion-reduce:transition-none"
      viewBox="0 0 16 16"
      fill="none"
      aria-hidden="true"
    >
      <path d="M6 4l4 4-4 4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
    </svg>
    <span class="font-bold text-strong">
      <span class="group-open:hidden">Read the full transcript</span>
      <span class="hidden group-open:inline">Hide transcript</span>
    </span>
    <span class="ml-auto text-xs text-muted">{spoken} turns</span>
  </summary>

  <div class="@container border-t border-line px-3 py-5 sm:px-5">
    <p class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-1 font-sans text-xs text-muted">
      <span class="inline-flex items-center gap-1.5">
        <span class="size-2 rounded-full bg-cyan" aria-hidden="true"></span>
        <span><span class="font-bold text-cyan">{first}</span> = interviewer ({interviewer})</span>
      </span>
      <span class="inline-flex items-center gap-1.5">
        <span class="size-2 rounded-full bg-orange" aria-hidden="true"></span>
        <span><span class="font-bold text-orange">{participant}</span> = participant</span>
      </span>
    </p>
    <ol class="space-y-1.5">
      {
        turns.map((turn) =>
          'note' in turn ? (
            <li class="my-6 flex items-center gap-3 font-sans text-xs text-muted italic">
              <span class="h-px flex-1 bg-line" aria-hidden="true" />
              <span class="max-w-[48ch] text-center">{turn.note}</span>
              <span class="h-px flex-1 bg-line" aria-hidden="true" />
            </li>
          ) : (
            <li
              class:list={[
                'flex flex-wrap gap-x-4 gap-y-0.5 rounded-md px-3 py-2',
                turn.s === 'P' && 'bg-raised',
              ]}
            >
              <span
                class:list={[
                  'w-[5.5rem] flex-none pt-[0.2rem] font-sans text-xs font-bold tracking-wide',
                  turn.s === 'I' ? 'text-cyan' : 'text-orange',
                ]}
              >
                {turn.s === 'I' ? first : participant}
              </span>
              <p class:list={['max-w-[68ch] min-w-0 flex-1 basis-[16rem]', turn.s === 'I' ? 'text-soft' : 'text-fg']}>{turn.t}</p>
            </li>
          ),
        )
      }
    </ol>
  </div>
</details>
